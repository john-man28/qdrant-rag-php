
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_MODEL=qwen3.5-4b-mlx@4bit
EMBEDDING_MODEL=text-embedding-mxbai-embed-large-v1
OPENAI_TIMEOUT=60

DENSE_EMBEDDING_BASE_URL="${OPENAI_BASE_URL}"
DENSE_EMBEDDING_API_KEY="${OPENAI_API_KEY}"
DENSE_EMBEDDING_MODEL="${EMBEDDING_MODEL}"
DENSE_EMBEDDING_TIMEOUT="${OPENAI_TIMEOUT}"

SPARSE_EMBEDDING_BASE_URL=
SPARSE_EMBEDDING_API_KEY=
SPARSE_EMBEDDING_MODEL=
SPARSE_EMBEDDING_TIMEOUT=60

LATE_INTERACTION_BASE_URL=
LATE_INTERACTION_API_KEY=
LATE_INTERACTION_MODEL=
LATE_INTERACTION_TIMEOUT=60

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=catalog
QDRANT_TIMEOUT=60
QDRANT_VECTOR_SIZE=1024
QDRANT_DENSE_VECTOR_SIZE="${QDRANT_VECTOR_SIZE}"
QDRANT_LATE_VECTOR_SIZE=
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QDRANT_LATE_VECTOR_NAME=late
QDRANT_SPARSE_MODIFIER=idf

CATALOG_SEARCH_HYBRID_ENABLED=false
CATALOG_SEARCH_HYBRID_PREFETCH_LIMIT=20

# Catalog reload (export + chunk indexing)
CATALOG_RELOAD_LINES_PER_CHUNK=256
CATALOG_EMBED_BATCH_SIZE=64
CATALOG_QDRANT_UPLOAD_BATCH_SIZE=64

CHAT_TOP_K=10

VITE_APP_NAME="${APP_NAME}"

# BigCommerce
BC_API_TOKEN_STAGING=
BC_STORE_HASH_STAGING=
BC_API_TOKEN_PROD=
BC_STORE_HASH_PROD=
